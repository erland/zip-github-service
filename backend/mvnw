#!/bin/sh
set -eu
BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROPS="$BASE_DIR/.mvn/wrapper/maven-wrapper.properties"
URL=$(sed -n 's/^distributionUrl=//p' "$PROPS" | head -n 1)
[ -n "$URL" ] || { echo "Missing distributionUrl in $PROPS" >&2; exit 1; }
VERSION=$(printf '%s' "$URL" | sed -n 's#.*apache-maven-\([0-9][0-9.]*\)-bin\.zip#\1#p')
[ -n "$VERSION" ] || { echo "Unable to determine Maven version from distributionUrl" >&2; exit 1; }
CACHE_ROOT=${MAVEN_WRAPPER_CACHE:-"${HOME}/.m2/wrapper/dists"}
MAVEN_HOME="$CACHE_ROOT/apache-maven-$VERSION"
if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  TMP_DIR=$(mktemp -d)
  trap 'rm -rf "$TMP_DIR"' EXIT HUP INT TERM
  ARCHIVE="$TMP_DIR/maven.zip"
  echo "Downloading Maven $VERSION..." >&2
  if command -v curl >/dev/null 2>&1; then
    curl --fail --location --silent --show-error "$URL" --output "$ARCHIVE"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$URL" -O "$ARCHIVE"
  else
    echo "curl or wget is required to bootstrap Maven" >&2
    exit 1
  fi
  mkdir -p "$CACHE_ROOT"
  if command -v unzip >/dev/null 2>&1; then
    unzip -q "$ARCHIVE" -d "$CACHE_ROOT"
  else
    echo "unzip is required to bootstrap Maven" >&2
    exit 1
  fi
fi
exec "$MAVEN_HOME/bin/mvn" -f "$BASE_DIR/pom.xml" "$@"
