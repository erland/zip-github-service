# Copy to .env. Never commit .env or private keys.
POSTGRES_DB=zip_github
POSTGRES_USER=zip_github
POSTGRES_PASSWORD=replace-with-a-long-random-password
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Container images used by the server compose file. Override only when using a fork or alternate registry.
ZIP_GITHUB_VERSION=1.0.0-rc.11
ZIP_GITHUB_BACKEND_IMAGE=ghcr.io/erland/zip-github-service-backend
ZIP_GITHUB_FRONTEND_IMAGE=ghcr.io/erland/zip-github-service-frontend

# Public browser origin and GitHub App user-authorization callback. These values
# must exactly match the deployed URL and the GitHub App callback configuration.
ZIP_GITHUB_FRONTEND_URL=http://localhost:5173
GITHUB_APP_CALLBACK_URL=http://localhost:8080/api/auth/github/callback
ZIP_GITHUB_SECURE_COOKIES=false
ZIP_GITHUB_CSRF_ENABLED=true

# GitHub App user authorization: use the Client ID and Client Secret from the same GitHub App.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# GitHub App installation authentication: use the numeric App ID and a PKCS#8 private key. In an env file, keep
# the value on one line and represent newlines as literal \n sequences.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Temporary ZIP uploads and cleanup.
ZIP_GITHUB_UPLOAD_MAX_COMPRESSED_BYTES=104857600
ZIP_GITHUB_UPLOAD_RETENTION_HOURS=24
ZIP_GITHUB_UPLOAD_CLEANUP_INTERVAL=1h

# ZIP inspection/decompression safety limits.
ZIP_GITHUB_ARCHIVE_MAX_UNCOMPRESSED_BYTES=524288000
ZIP_GITHUB_ARCHIVE_MAX_ENTRIES=20000
ZIP_GITHUB_ARCHIVE_MAX_SINGLE_FILE_BYTES=52428800
ZIP_GITHUB_ARCHIVE_MAX_PATH_LENGTH=1024
ZIP_GITHUB_ARCHIVE_MAX_COMPRESSION_RATIO=100.0

# Commit identity.
ZIP_GITHUB_GIT_AUTHOR_NAME=zip-github
ZIP_GITHUB_GIT_AUTHOR_EMAIL=zip-github@users.noreply.github.com

# Operations scripts. Backups are written outside Docker volumes by default.
ZIP_GITHUB_BACKUP_DIR=./backups/postgres
ZIP_GITHUB_BACKUP_RETENTION_DAYS=14

# Keep request throttling enabled in production.
ZIP_GITHUB_RATE_LIMIT_ENABLED=true
