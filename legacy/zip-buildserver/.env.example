# zip-buildserver local configuration

# Change this before exposing the service.
ZIP_BUILDSERVER_AUTH_ENABLED=true
ZIP_BUILDSERVER_API_TOKEN=change-me

# HTTP ports exposed by Docker Compose.
BACKEND_PORT=8080
FRONTEND_PORT=5173
POSTGRES_PORT=5432

# PostgreSQL defaults for local Docker Compose development.
POSTGRES_DB=zip_buildserver
POSTGRES_USER=zip_buildserver
POSTGRES_PASSWORD=zip_buildserver

# Local storage defaults used by the backend container.
ZIP_BUILDSERVER_DATA_DIR=/data/zip-buildserver

# Worker execution. Use fake for deterministic local development, docker for real verification runs.
ZIP_BUILDSERVER_WORKER_EXECUTOR=fake
ZIP_BUILDSERVER_WORKER_IMAGE=zip-buildserver-worker-node-maven:local
ZIP_BUILDSERVER_WORKER_MEMORY=2g
ZIP_BUILDSERVER_WORKER_CPUS=2
ZIP_BUILDSERVER_WORKER_NETWORK=bridge
ZIP_BUILDSERVER_WORKER_MAX_OUTPUT_BYTES=1048576
ZIP_BUILDSERVER_PACKAGES_DIR=target/zip-buildserver/packages
ZIP_BUILDSERVER_WORKSPACES_DIR=target/zip-buildserver/workspaces
ZIP_BUILDSERVER_WORKER_HOST_WORKSPACES_DIR=

# Artifact storage
ZIP_BUILDSERVER_ARTIFACTS_DIR=./data/artifacts
ZIP_BUILDSERVER_ARTIFACT_RETENTION_DAYS=14

# Retention cleanup
ZIP_BUILDSERVER_RETENTION_CLEANUP_ENABLED=true
ZIP_BUILDSERVER_RETENTION_CLEANUP_INTERVAL=24h
ZIP_BUILDSERVER_PACKAGE_RETENTION_DAYS=7
ZIP_BUILDSERVER_ARTIFACT_RETENTION_DAYS=14
ZIP_BUILDSERVER_SESSION_RETENTION_DAYS=90
ZIP_BUILDSERVER_WORKSPACE_CLEANUP_GRACE_MINUTES=60

# End-to-end Docker verification helpers
# Set ZIP_BUILDSERVER_DATA_HOST_DIR to an absolute host path when using Docker-based execution
# from Docker Compose so nested worker containers can mount extracted workspaces.
ZIP_BUILDSERVER_DATA_HOST_DIR=
ZIP_BUILDSERVER_BACKEND_USER=zipbuildserver

# Frontend API base URL for local Vite development.
VITE_API_BASE_URL=http://localhost:8080
