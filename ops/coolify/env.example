# Release images
ZIP_GITHUB_VERSION=1.0.0-rc.129
ZIP_GITHUB_BACKEND_IMAGE=ghcr.io/erland/zip-github-service-backend
ZIP_GITHUB_FRONTEND_IMAGE=ghcr.io/erland/zip-github-service-frontend

# Shared PostgreSQL
DB_HOST=replace-with-coolify-postgres-host
POSTGRES_DB=zip_github
POSTGRES_USER=zip_github
POSTGRES_PASSWORD=replace-with-long-random-password

# Public URL and GitHub App callback
ZIP_GITHUB_FRONTEND_URL=https://zip-github.apps.isaksson.info
GITHUB_APP_CALLBACK_URL=https://zip-github.apps.isaksson.info/api/auth/github/callback
ZIP_GITHUB_SECURE_COOKIES=true
ZIP_GITHUB_CSRF_ENABLED=true

# GitHub App user authorization
GITHUB_APP_CLIENT_ID=replace-me
GITHUB_APP_CLIENT_SECRET=replace-me

# GitHub App installation authentication
GITHUB_APP_ID=replace-me
# PKCS#8 PEM on one line with literal \n sequences.
GITHUB_APP_PRIVATE_KEY=replace-me

# Upload/request limits
ZIP_GITHUB_UPLOAD_MAX_COMPRESSED_BYTES=209715200
QUARKUS_HTTP_LIMITS_MAX_BODY_SIZE=200M
ZIP_GITHUB_NGINX_CLIENT_MAX_BODY_SIZE=200M
ZIP_GITHUB_UPLOAD_RETENTION_HOURS=24
ZIP_GITHUB_UPLOAD_CLEANUP_INTERVAL=1h

# Staging transport
ZIP_GITHUB_STAGING_UPLOAD_CREDENTIAL=
ZIP_GITHUB_STAGING_AVAILABLE_TTL_MINUTES=60
ZIP_GITHUB_STAGING_CLAIMED_TTL_MINUTES=240
ZIP_GITHUB_STAGING_CLEANUP_INTERVAL=5m
ZIP_GITHUB_STAGING_CLEANUP_BATCH_SIZE=100
ZIP_GITHUB_STAGING_MAX_LIVE_OBJECTS=100
ZIP_GITHUB_STAGING_MAX_LIVE_BYTES=1073741824

# ZIP inspection limits
ZIP_GITHUB_ARCHIVE_MAX_UNCOMPRESSED_BYTES=524288000
ZIP_GITHUB_ARCHIVE_MAX_ENTRIES=20000
ZIP_GITHUB_ARCHIVE_MAX_SINGLE_FILE_BYTES=52428800
ZIP_GITHUB_ARCHIVE_MAX_PATH_LENGTH=1024
ZIP_GITHUB_ARCHIVE_MAX_COMPRESSION_RATIO=100.0

# Security and persistence
ZIP_GITHUB_RATE_LIMIT_ENABLED=true
ZIP_GITHUB_TRUST_FORWARDED_FOR=false
ZIP_GITHUB_PROJECT_PERSISTENCE_ENABLED=true

# Controlled GitHub Actions writes
ZIP_GITHUB_ACTIONS_ALLOWED_DISPATCH_WORKFLOWS=
ZIP_GITHUB_ACTIONS_ALLOWED_RERUN_WORKFLOWS=

# Optional signed Shortcut distribution. Leave empty when unpublished.
ZIP_GITHUB_SHORTCUT_RELEASE_PATH=
ZIP_GITHUB_SHORTCUT_VERSION=1
ZIP_GITHUB_SHORTCUT_GENERATION=g1
